rules_version = '2';

// Security rules for the 21 Forth Cres household ledger.
//
// This is what ACTUALLY restricts access to your financial data — not the
// sign-in gate in index.html, which is just UI. Anyone could open the
// browser console and try to read/write Firestore directly; these rules
// are enforced server-side by Firebase itself and can't be bypassed from
// the client.
//
// SETUP: replace the two placeholder emails below with your real Google
// account emails, then paste this whole file into:
//   Firebase Console > Firestore Database > Rules > (replace contents) > Publish
//
// Keep this list in sync with the ALLOWED_EMAILS array in index.html's
// Firebase script block (that one is cosmetic only, this one is real).

service cloud.firestore {
  match /databases/{database}/documents {
    match /household/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in [
          "hannah.isabella@googlemail.com",
          "thomas.jenkins1986@gmail.com"
        ];
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
